Options -Indexes

# Caching: hashed build assets never change -> cache for 1 year (no revalidation round trip)
<IfModule mod_headers.c>
    <FilesMatch "^(index-.*|vendor-.*)\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(jpg|jpeg|png|svg|ico|woff|woff2|mp4|webm)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    <FilesMatch "^(index\.html|sw\.js|manifest\.json)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# ─── MIME Types ───────────────────────────────────────────────────────────────
AddType application/manifest+json .json
AddType application/javascript .js .mjs
AddType text/css .css
AddType video/mp4 .mp4
AddType video/webm .webm

# ─── Static files — serve directly, no rewrite ───────────────────────────────
<FilesMatch "\.(js|mjs|css|json|jpg|jpeg|png|svg|ico|woff|woff2|ttf|eot|webp|gif|map|mp4|webm)$">
    RewriteEngine Off
</FilesMatch>

# ─── SPA Routing ─────────────────────────────────────────────────────────────
RewriteEngine On
RewriteBase /

# Skip if file/dir exists
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Skip API calls
RewriteCond %{REQUEST_URI} ^/api [NC]
RewriteRule ^ - [L]

# All other routes → index.html
RewriteRule ^ /index.html [L]
