// ─── Detect encoding & decode buffer to string ────────────────────────────────
function decodeBuffer(buffer: Buffer): string {
  // 1. BOM checks
  if (buffer[0] === 0xFF && buffer[1] === 0xFE) {
    // UTF-16 LE BOM
    return buffer.slice(2).toString("utf16le");
  }
  if (buffer[0] === 0xFE && buffer[1] === 0xFF) {
    // UTF-16 BE BOM
    const swapped = Buffer.allocUnsafe(buffer.length - 2);
    for (let i = 2; i < buffer.length - 1; i += 2) {
      swapped[i - 2] = buffer[i + 1];
      swapped[i - 1] = buffer[i];
    }
    return swapped.toString("utf16le");
  }
  if (buffer[0] === 0xEF && buffer[1] === 0xBB && buffer[2] === 0xBF) {
    // UTF-8 BOM
    return buffer.slice(3).toString("utf-8");
  }

  // 2. Try UTF-8 — if valid (no replacement chars), use it
  const utf8 = buffer.toString("utf-8");
  if (!utf8.includes("\uFFFD")) return utf8;

  // 3. Fallback: Windows-1256 (Arabic legacy encoding)
  try {
    const td = new TextDecoder("windows-1256", { fatal: false });
    return td.decode(buffer);
  } catch {
    return buffer.toString("latin1");
  }
}